[sub_resource type="GDScript" id="GDScript_showcase"]
script/source = "extends Node3D

@onready var hud: RetroHUD = $RetroHUD
@onready var screen_fx: ScreenEffectsManager = $ScreenEffectsManager

var _rings_collected: int = 0

func _ready() -> void:
	# Connect ring collection
	for ring in get_tree().get_nodes_in_group(\"currency\"):
		if ring.has_signal(\"collected\"):
			ring.collected.connect(_on_ring_collected)
	
	# Start timer
	hud.start_timer()

func _on_ring_collected(_ring: Node) -> void:
	_rings_collected += 1
	hud.add_rings(1)
	hud.add_score(100)
	screen_fx.flash_ring_collect()

func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_1:
				screen_fx.flash_damage()
			KEY_2:
				screen_fx.fade_transition(1.0)
			KEY_3:
				screen_fx.iris_transition(1.5)
			KEY_4:
				screen_fx.horizontal_wipe(1.0)
			KEY_5:
				screen_fx.pixelate_transition(1.5)
			KEY_R:
				# Reset scene
				get_tree().reload_current_scene()
"

